    interval: 300
    tolerance: 50 
    proxies:
      - '🇷🇺 RU | 🟢 | vless | @NamiraConfigs | 54'

  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇷🇺 RU | 🟢 | vless | @NamiraConfigs | 54'
      
  - name: All-Proxies
    type: select
    proxies:
      - '🇷🇺 RU | 🟢 | vless | @NamiraConfigs | 54'

