  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇮🇷 IR | 🟢 | vless | @NamiraConfigs | 37'
      - '🇺🇸 US | 🔴 | vless | @NamiraConfigs | 38'
      - '🇬🇧 GB | 🔴 | vless | @NamiraConfigs | 39'
      - '🇬🇧 GB | 🔴 | vless | @NamiraConfigs | 40'
      
  - name: All-Proxies
