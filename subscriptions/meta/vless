    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 51'
      - '🇺🇸 US | 🔴 | vless | @NamiraConfigs | 52'
      - '🇩🇪 DE | 🔴 | vless | @NamiraConfigs | 53'
      
