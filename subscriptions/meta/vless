  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 61'
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 62'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 64'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 65'
      
  - name: All-Proxies
    type: select
    proxies:
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 61'
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 62'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 64'
