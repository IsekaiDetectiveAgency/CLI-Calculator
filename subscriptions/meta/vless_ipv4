mixed-port: 7890
allow-lan: true
mode: rule
log-level: error
ipv6: true
external-controller: 127.0.0.1:9090
profile:
  store-selected: true
  store-fake-ip: true
dns:
  enable: true
  ipv6: true
  default-nameserver: [1.1.1.1, 8.8.8.8]
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  nameserver: [8.8.4.4, 1.0.0.1, "https://1.0.0.1/dns-query"]

proxies:
  - {"name":"🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 63","type":"vless","server":"135.106.193.180","port":54,"uuid":"9972a440-39a6-4672-8883-5dd188863acf","tls":false,"network":"tcp","client-fingerprint":"chrome","udp":true}
  - {"name":"🇮🇷 IR | 🔴 | vless | @NamiraConfigs | 64","type":"vless","server":"95.38.184.199","port":996,"uuid":"36b78162-4e57-4e08-b3d0-ef13b788f7ec","tls":false,"network":"ws","client-fingerprint":"chrome","udp":true,"ws-opts":{"path":"/mmd","headers":{"Host":"95.38.184.199"}}}

rule-providers:
  ir_domains:
    type: http
    behavior: domain
    url: "https://github.com/bootmortis/iran-clash-rules/releases/latest/download/ir.txt"
    path: ./ruleset/ir.txt
    interval: 86400
  ir_cidr:
    type: http
    behavior: ipcidr
    url: "https://github.com/bootmortis/iran-clash-rules/releases/latest/download/ircidr.txt"
    path: ./ruleset/ircidr.txt
    interval: 86400

proxy-groups:
  - name: 🚀 PROXY
    type: select
    proxies:
      - ♻️ AUTO
      - 📉 Fallback
      - DIRECT
      - All-Proxies

  - name: ♻️ AUTO
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50 
    proxies:
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 63'
      - '🇮🇷 IR | 🔴 | vless | @NamiraConfigs | 64'

  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 63'
      - '🇮🇷 IR | 🔴 | vless | @NamiraConfigs | 64'
      
  - name: All-Proxies
    type: select
    proxies:
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 63'
      - '🇮🇷 IR | 🔴 | vless | @NamiraConfigs | 64'

rules:
  - IP-CIDR,127.0.0.1/32,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,198.18.0.1/16,DIRECT,no-resolve  # Clash Fake-IP range
  - RULE-SET,ir_domains,DIRECT
  - RULE-SET,ir_cidr,DIRECT
  - GEOIP,IR,DIRECT
  - MATCH,🚀 PROXY
