rule-providers:
  ir_domains:
    type: http
    behavior: domain
    url: "https://github.com/bootmortis/iran-clash-rules/releases/latest/download/ir.txt"
    path: ./ruleset/ir.txt
    interval: 86400
  ir_cidr:
    type: http
    behavior: ipcidr
    url: "https://github.com/bootmortis/iran-clash-rules/releases/latest/download/ircidr.txt"
    path: ./ruleset/ircidr.txt
    interval: 86400

proxy-groups:
  - name: 🚀 PROXY
    type: select
    proxies:
      - ♻️ AUTO
      - 📉 Fallback
      - DIRECT
      - All-Proxies

  - name: ♻️ AUTO
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50 
    proxies:
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 55'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 57'
      - '🇩🇪 DE | 🔴 | vless | @NamiraConfigs | 58'

  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 55'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 57'
      - '🇩🇪 DE | 🔴 | vless | @NamiraConfigs | 58'
      
  - name: All-Proxies
