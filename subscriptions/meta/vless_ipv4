    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 51'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 52'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 53'
      - '🇸🇬 SG | 🟢 | vless | @NamiraConfigs | 54'
      
  - name: All-Proxies
    type: select
    proxies:
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 51'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 52'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 53'
      - '🇸🇬 SG | 🟢 | vless | @NamiraConfigs | 54'

rules:
