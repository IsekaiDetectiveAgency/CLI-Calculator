mixed-port: 7890
allow-lan: true
mode: rule
log-level: error
ipv6: true
external-controller: 127.0.0.1:9090
profile:
  store-selected: true
  store-fake-ip: true
dns:
  enable: true
  ipv6: true
  default-nameserver: [1.1.1.1, 8.8.8.8]
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  nameserver: [8.8.4.4, 1.0.0.1, "https://1.0.0.1/dns-query"]

proxies:
  - {"name":"🇮🇷 IR | 🔴 | vless | @NamiraConfigs | 51","type":"vless","server":"p01.parsi.sbs","port":2086,"uuid":"1ee1f28d-4975-4d7c-95c7-76172c20eed5","tls":false,"network":"ws","client-fingerprint":"chrome","udp":true,"ws-opts":{"path":"/","headers":{"Host":"parsi.parsi.sbs"}}}
  - {"name":"🇳🇱 NL | 🟢 | vless | @NamiraConfigs | 55","type":"vless","server":"ddc-chr.astralweb.tech","port":443,"uuid":"3ad1d277-5715-4ca1-84db-5baea72f822d","tls":true,"network":"tcp","client-fingerprint":"chrome","udp":true,"servername":"ddc-chr.astralweb.tech"}

rule-providers:
  ir_domains:
    type: http
    behavior: domain
    url: "https://github.com/bootmortis/iran-clash-rules/releases/latest/download/ir.txt"
    path: ./ruleset/ir.txt
    interval: 86400
  ir_cidr:
    type: http
    behavior: ipcidr
    url: "https://github.com/bootmortis/iran-clash-rules/releases/latest/download/ircidr.txt"
    path: ./ruleset/ircidr.txt
    interval: 86400

proxy-groups:
  - name: 🚀 PROXY
    type: select
    proxies:
      - ♻️ AUTO
      - 📉 Fallback
      - DIRECT
      - All-Proxies

  - name: ♻️ AUTO
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50 
    proxies:
      - '🇮🇷 IR | 🔴 | vless | @NamiraConfigs | 51'
      - '🇳🇱 NL | 🟢 | vless | @NamiraConfigs | 55'

  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇮🇷 IR | 🔴 | vless | @NamiraConfigs | 51'
      - '🇳🇱 NL | 🟢 | vless | @NamiraConfigs | 55'
      
  - name: All-Proxies
    type: select
    proxies:
      - '🇮🇷 IR | 🔴 | vless | @NamiraConfigs | 51'
      - '🇳🇱 NL | 🟢 | vless | @NamiraConfigs | 55'

rules:
  - IP-CIDR,127.0.0.1/32,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,198.18.0.1/16,DIRECT,no-resolve  # Clash Fake-IP range
  - RULE-SET,ir_domains,DIRECT
  - RULE-SET,ir_cidr,DIRECT
  - GEOIP,IR,DIRECT
  - MATCH,🚀 PROXY
