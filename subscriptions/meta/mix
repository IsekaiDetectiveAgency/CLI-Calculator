  - name: All-Proxies
    type: select
    proxies:
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 44'
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 46'
      - '🇺🇸 US | 🟢 | vmess | @NamiraConfigs | 47'
      - '🇮🇳 IN | 🔴 | vmess | @NamiraConfigs | 48'

