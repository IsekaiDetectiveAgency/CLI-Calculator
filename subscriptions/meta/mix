mixed-port: 7890
allow-lan: true
mode: rule
log-level: error
ipv6: true
external-controller: 127.0.0.1:9090
profile:
  store-selected: true
  store-fake-ip: true
dns:
  enable: true
  ipv6: true
  default-nameserver: [1.1.1.1, 8.8.8.8]
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  nameserver: [8.8.4.4, 1.0.0.1, "https://1.0.0.1/dns-query"]

proxies:
  - {"name":"🇲🇾 MY | 🔴 | vmess | @NamiraConfigs | 55","type":"vmess","server":"47.250.135.244","port":10000,"cipher":"auto","uuid":"aedc66b8-99d7-4a21-8310-61870e7f870d","alterId":"0","tls":false,"skip-cert-verify":true,"network":"tcp"}
  - {"name":"🇺🇸 US | 🔴 | vmess | @NamiraConfigs | 57","type":"vmess","server":"165.140.216.141","port":443,"cipher":"auto","uuid":"e7d72a8d-26f2-4b54-b366-0c43e0bcba7d","alterId":"0","tls":false,"skip-cert-verify":true,"network":"tcp"}

rule-providers:
  ir_domains:
    type: http
    behavior: domain
    url: "https://github.com/bootmortis/iran-clash-rules/releases/latest/download/ir.txt"
    path: ./ruleset/ir.txt
    interval: 86400
  ir_cidr:
    type: http
    behavior: ipcidr
    url: "https://github.com/bootmortis/iran-clash-rules/releases/latest/download/ircidr.txt"
    path: ./ruleset/ircidr.txt
    interval: 86400

proxy-groups:
  - name: 🚀 PROXY
    type: select
    proxies:
      - ♻️ AUTO
      - 📉 Fallback
      - DIRECT
      - All-Proxies

  - name: ♻️ AUTO
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50 
    proxies:
      - '🇲🇾 MY | 🔴 | vmess | @NamiraConfigs | 55'
      - '🇺🇸 US | 🔴 | vmess | @NamiraConfigs | 57'

  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇲🇾 MY | 🔴 | vmess | @NamiraConfigs | 55'
      - '🇺🇸 US | 🔴 | vmess | @NamiraConfigs | 57'
      
  - name: All-Proxies
    type: select
    proxies:
      - '🇲🇾 MY | 🔴 | vmess | @NamiraConfigs | 55'
      - '🇺🇸 US | 🔴 | vmess | @NamiraConfigs | 57'

rules:
  - IP-CIDR,127.0.0.1/32,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,198.18.0.1/16,DIRECT,no-resolve  # Clash Fake-IP range
  - RULE-SET,ir_domains,DIRECT
  - RULE-SET,ir_cidr,DIRECT
  - GEOIP,IR,DIRECT
  - MATCH,🚀 PROXY
