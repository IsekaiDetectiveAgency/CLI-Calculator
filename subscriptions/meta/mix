      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 57'

  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇺🇸 US | 🔴 | vless | @NamiraConfigs | 53'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 54'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 55'
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 56'
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 57'
      
  - name: All-Proxies
    type: select
    proxies:
      - '🇺🇸 US | 🔴 | vless | @NamiraConfigs | 53'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 54'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 55'
