      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 53'

  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇷🇺 RU | 🟢 | vless | @NamiraConfigs | 49'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 50'
      - '🇷🇺 RU | 🔴 | vless | @NamiraConfigs | 51'
      - '🇩🇪 DE | 🔴 | vless | @NamiraConfigs | 52'
