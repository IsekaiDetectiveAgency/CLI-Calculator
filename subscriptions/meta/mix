rule-providers:
  ir_domains:
    type: http
    behavior: domain
    url: "https://github.com/bootmortis/iran-clash-rules/releases/latest/download/ir.txt"
    path: ./ruleset/ir.txt
    interval: 86400
  ir_cidr:
    type: http
    behavior: ipcidr
    url: "https://github.com/bootmortis/iran-clash-rules/releases/latest/download/ircidr.txt"
    path: ./ruleset/ircidr.txt
    interval: 86400

proxy-groups:
  - name: 🚀 PROXY
    type: select
    proxies:
      - ♻️ AUTO
      - 📉 Fallback
      - DIRECT
      - All-Proxies

  - name: ♻️ AUTO
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50 
    proxies:
      - '🇬🇧 GB | 🔴 | vless | @NamiraConfigs | 52'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 53'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 54'
      - '🇩🇪 DE | 🔴 | vless | @NamiraConfigs | 55'
      - '🇩🇪 DE | 🟢 | vless | @NamiraConfigs | 56'

  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇬🇧 GB | 🔴 | vless | @NamiraConfigs | 52'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 53'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 54'
      - '🇩🇪 DE | 🔴 | vless | @NamiraConfigs | 55'
      - '🇩🇪 DE | 🟢 | vless | @NamiraConfigs | 56'
      
  - name: All-Proxies
    type: select
    proxies:
      - '🇬🇧 GB | 🔴 | vless | @NamiraConfigs | 52'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 53'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 54'
      - '🇩🇪 DE | 🔴 | vless | @NamiraConfigs | 55'
      - '🇩🇪 DE | 🟢 | vless | @NamiraConfigs | 56'

rules:
  - IP-CIDR,127.0.0.1/32,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,198.18.0.1/16,DIRECT,no-resolve  # Clash Fake-IP range
  - RULE-SET,ir_domains,DIRECT
  - RULE-SET,ir_cidr,DIRECT
  - GEOIP,IR,DIRECT
  - MATCH,🚀 PROXY
