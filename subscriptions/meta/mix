  - name: 📉 Fallback
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - '🇩🇪 DE | 🟢 | vless | @NamiraConfigs | 50'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 52'
      - '🇱🇺 LU | 🟢 | vless | @NamiraConfigs | 53'
      - '🇺🇸 US | 🟢 | trojan | @NamiraConfigs | 54'
      
  - name: All-Proxies
    type: select
    proxies:
      - '🇩🇪 DE | 🟢 | vless | @NamiraConfigs | 50'
      - '🇺🇸 US | 🟢 | vless | @NamiraConfigs | 52'
      - '🇱🇺 LU | 🟢 | vless | @NamiraConfigs | 53'
      - '🇺🇸 US | 🟢 | trojan | @NamiraConfigs | 54'

